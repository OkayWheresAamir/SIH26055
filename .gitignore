.venv/
venv/

# Claude Code's own local config/permissions — machine-specific, not shared.
.claude/

__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*.egg-info/

# Turing dataset — large and gated, not committed
data/

# Extracted text and calibration for docsearch — derived from docs/, rebuilt on demand
.docindex/

# Personal Claude Code instructions — never shared
CLAUDE.local.md

# Evaluation artefacts — episode logs, waterfalls, metrics.json. Derived from
# the environment and rebuilt by re-running it; this repo stays clean of them.
# Checkpoints are the exception: nothing regenerates them, and they have to
# reach teammates somehow. `runs/*` not `runs/`, because git does not look
# inside an excluded directory and the negations would never fire.
runs/*
!runs/checkpoints/

!runs/checkpoints/*.zip
!runs/checkpoints/*.json

# Dated copies of runs/ taken before a destructive re-run. Same reasoning as
# runs/ itself, and they are large (the 2026-09-09 one is 224 MB): the
# checkpoints and artefacts they hold are not source, and the record of what
# was in them lives in scratch/TRAINING_JOURNEY.md instead.
runs_backup_*/

# Handoff intermediates — `scripts/md2pdf.py` writes an .html on the way to the
# .pdf. The .md is the source and the .pdf is what gets handed over; the .html
# is neither.
docs/project/*_HANDOFF.html


Claude outputs/